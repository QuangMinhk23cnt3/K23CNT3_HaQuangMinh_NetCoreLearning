@model List<HqmLab06.Models.HqmEmployee>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"/>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
		<h2 class="text-center mb-4">Danh sách nhân viên</h2>
        <a href="/HqmEmployee/HqmCreate" class="btn btn-primary">Create</a>
	</div>

        <table class="table table-bordered table-hover table-striped">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Lương</th>
                    <th>Trạng thái</th>
                    <th>Chuc nang</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hqmEmp in Model)
                {
                    <tr>
                        <td class="text-center">@hqmEmp.HqmId</td>
                        <td>@hqmEmp.HqmName</td>
                        <td>@hqmEmp.HqmBirthDay.ToString("dd/MM/yyyy")</td>
                        <td>@hqmEmp.HqmEmail</td>
                        <td>@hqmEmp.HqmPhone</td>
                        <td>@hqmEmp.HqmSalary.ToString("N0") đ</td>
                        <td class="text-center">
                            @if (hqmEmp.HqmStatus)
                            {
                                <span class="badge bg-success">Online</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Offline</span>
                            }
                        </td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="HqmEdit" asp-route-id="@hqmEmp.HqmId">Sửa</a>
                        <a class="btn btn-sm btn-danger" asp-action="HqmDelete" asp-route-id="@hqmEmp.HqmId">Xoá</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>