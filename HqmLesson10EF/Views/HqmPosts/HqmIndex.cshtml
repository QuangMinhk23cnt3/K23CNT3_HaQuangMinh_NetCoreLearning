@model IEnumerable<HqmLesson10EF.Models.HqmPost>

@{
    ViewData["Title"] = "Quan ly bai viet";
}




<div class="d-flex justify-content-between align-items-center mb-2">
    <h1>Quan ly bai viet</h1>
        <a asp-action="HqmCreate" class="btn btn-primary">Them moi</a>
</div>
<table class="table table-bordered mt-2">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HqmId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HqmTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HqmImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HqmContent)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HqmStatus)
            </th>
            <th>Chuc nang</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.HqmId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HqmTitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HqmImage)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HqmContent)
                </td>
                <td class="d-flex justify-content-between align-items-center mb-2">
                    @if (item.HqmStatus == true)
                    {
                        <span class="badge bg-success">Hien thi</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Tam an</span>
                    }
            </td>
            <td>
                <a asp-action="HqmEdit" asp-route-hqmId="@item.HqmId" class="btn btn-primary">Edit</a> |
                    <a asp-action="HqmDetails" asp-route-hqmId="@item.HqmId" class="btn btn-warning">Details</a> |
                    <a asp-action="HqmDelete" asp-route-hqmId="@item.HqmId" class="btn btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
