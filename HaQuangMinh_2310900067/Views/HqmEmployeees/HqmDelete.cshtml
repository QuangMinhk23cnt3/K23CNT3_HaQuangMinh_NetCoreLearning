@model HaQuangMinh_2310900067.Models.HqmEmployeee

@{
    ViewData["Title"] = "Xác nhận xóa thông tin bài viết";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        <h4 class="text-center">Bạn có chắc muốn xóa nhân viên này?</h4>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.HqmEmpName)</dd>

            <dt class="col-sm-4">Cấp bậc</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.HqmEmpLevel)</dd>

            <dt class="col-sm-4">Ngày bắt đầu</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.HqmEmpStartDate)</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            @if (Model.HqmEmpStatus == true)
            {
                <p>Hiển thị</p>
            }
            else
            {
                <p>Tạm ẩn</p>
            }
        </dl>
    </div>

    <div class="card-footer text-center">
        <form asp-action="HqmDelete">
            <input type="hidden" asp-for="HqmEmpId" />
            <button type="submit" class="btn btn-danger">🗑️ Xác nhận xóa</button>
            <a asp-action="HqmIndex" class="btn btn-secondary">⬅️ Quay lại</a>
        </form>
    </div>
</div>
