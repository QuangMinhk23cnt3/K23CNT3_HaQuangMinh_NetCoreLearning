@model HaQuangMinh_2310900067.Models.HqmEmployeee

@{
    ViewData["Title"] = "Sua thong tin nhan vien";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-warning text-dark">
        <h4 class="text-center">@ViewData["Title"]</h4>
    </div>

    <div class="card-body">
        <form asp-action="HqmEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="HqmEmpId" />

            <div class="mb-3">
                <label asp-for="HqmEmpName" class="form-label fw-semibold"></label>
                <input asp-for="HqmEmpName" class="form-control" placeholder="Nhập tên nhân viên" />
                <span asp-validation-for="HqmEmpName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HqmEmpLevel" class="form-label fw-semibold"></label>
                <input asp-for="HqmEmpLevel" class="form-control" placeholder="Nhập cấp bậc" />
                <span asp-validation-for="HqmEmpLevel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HqmEmpStartDate" class="form-label fw-semibold"></label>
                <input asp-for="HqmEmpStartDate" type="date" class="form-control" />
                <span asp-validation-for="HqmEmpStartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HqmEmpStatus" class="form-label fw-semibold"></label>
                <select asp-for="HqmEmpStatus" class="form-select">
                    <option value="true" selected="@Model.HqmEmpStatus">Hiển thị</option>
                    <option value="false" selected="!@Model.HqmEmpStatus">Tạm ẩn</option>
                </select>
                <span asp-validation-for="HqmEmpStatus" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
                <a asp-action="HqmIndex" class="btn btn-secondary ms-2">⬅️ Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}