@model HqmLesson07.Models.HqmEmployee

@{
    ViewData["Title"] = "Them moi nhan vien";
}

<h1>Them moi nhan vien</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="HqmCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="HqmId" class="control-label"></label>
                <input asp-for="HqmId" class="form-control" />
                <span asp-validation-for="HqmId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HqmName" class="control-label"></label>
                <input asp-for="HqmName" class="form-control" />
                <span asp-validation-for="HqmName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HqmBirthDay" class="control-label"></label>
                <input asp-for="HqmBirthDay" class="form-control" />
                <span asp-validation-for="HqmBirthDay" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HqmEmail" class="control-label"></label>
                <input asp-for="HqmEmail" class="form-control" />
                <span asp-validation-for="HqmEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HqmPhone" class="control-label"></label>
                <input asp-for="HqmPhone" class="form-control" />
                <span asp-validation-for="HqmPhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HqmSalary" class="control-label"></label>
                <input asp-for="HqmSalary" class="form-control" />
                <span asp-validation-for="HqmSalary" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="HqmStatus" /> @Html.DisplayNameFor(model => model.HqmStatus)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="HqmIndex">Back to List</a>
</div>

